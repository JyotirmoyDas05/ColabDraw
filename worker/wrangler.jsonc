{
  "name": "colabdraw-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "vars": {
    "GEMINI_MODELS": "gemini-3.5-flash-lite",
    "AI_TRIAL_PER_DEVICE": "20",
    "AI_TRIAL_PER_IP": "40",
    "AI_TRIAL_GLOBAL": "400"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colabdraw",
      "database_id": "61ea32c6-c7ab-4482-87d0-4dcf86a83df9"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "colabdraw-files" }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
